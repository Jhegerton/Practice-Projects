package one;
import java.util.Date;

public class Person {
	private String name;
	private String number; // Phone Number
	private Date dob; // Date of Birth
	
	public Person(String name, String number, Date dob) {
		this.name = name;
		this.number = number;
		this.dob = dob;
	}
	
	/**
	 * getter name
	 * @return name
	 */
	public String name() { 
		return this.name;
	}
	/**
	 * setter name
	 * @param name
	 */
	public void name(String name) {
		this.name = name;
	}
	
	/**
	 * getter number
	 * @return number
	 */
	public String number() { // getter number
		return this.number;
	}
	
	/**
	 * setter number
	 * @param number
	 */
	public void number(String number) {
		this.name = number;
	}
	
	/**
	 * getter dob
	 * @return dob
	 */
	public Date dob() {
		return this.dob;
	}
	
	/**
	 * setter dob
	 * @param dob
	 */
	public void name(Date dob) { // setter dob
		this.dob.setTime(dob.getTime());
	}
	
	/**
	 * equals method
	 * @param p
	 * @return if equal
	 */
	public boolean equals(Person p) {
		return (
				this.name == p.name &&
				this.number == p.number &&
				this.dob.equals(p.dob)
				);
				
	}
	
	@Override
	public String toString() {
		return String.format("My name is %s%nMy phone number is %s%n and my dob is %s.", this.name, this.number, this.dob.);
		
	}
	
}
