package one;
import java.util.Date;

public class Person {
	private String name;
	private String number; // Phone Number
	private Date dob; // Date of Birth
	
	public Person(String name, String number, Date dob) {
		this.name = name;
		this.number = number;
		this.dob = dob;
	}
	
	public String name() { // getter name
		return this.name;
	}
	
	public void name(String name) { // setter name
		this.name = name;
	}
	
	public String number() { // getter number
		return this.number;
	}
	
	public void number(String number) { // setter number
		this.name = number;
	}
	
	public Date dob() { // getter dob
		return this.dob;
	}
	
	public void name(Date dob) { // setter dob
		int tmpDate = (int) dob.getTime();
		this.dob.set(tmpDate);
	}
	
	@Override
	public String toString() {
		return String.format("My name is %s%nMy phone number is %s%n and my dob is %s.", this.name, this.number, this.dob.);
		
	}
}
